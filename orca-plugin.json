{
  "manifestVersion": 2,
  "id": "prototype-studio",
  "name": "Orca-Design",
  "version": "0.2.0",
  "execution": "trusted-worker",
  "main": "src/worker.js",
  "description": "Design projects in Orca: canvas, slides, design systems, dashboard and motion editors in one gallery tab.",
  "license": "MIT",
  "homepage": "https://github.com/hubo1989/orca-plugin-design",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Orca-Design 项目库：五类设计工具入口与作品卡片"
  },
  "screenshots": [
    {
      "path": "assets/gallery.png",
      "alt": "项目库页面：新建入口与三张作品卡片",
      "caption": "一个入口管理全部设计作品"
    },
    {
      "path": "assets/editor.png",
      "alt": "画布编辑器：无限画布与工具栏",
      "caption": "库内同 Tab 打开的画布编辑器"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "commands": [
      {
        "id": "prototype.skill.claude-design",
        "title": "Open Claude Design Editor",
        "when": "workspace"
      },
      {
        "id": "prototype.skill.claude-slides",
        "title": "Open Claude Slides Editor",
        "when": "workspace"
      },
      {
        "id": "prototype.skill.claude-design-system",
        "title": "Open Design System Editor",
        "when": "workspace"
      },
      {
        "id": "prototype.skill.claude-motion",
        "title": "Open Claude Motion Editor",
        "when": "workspace"
      },
      {
        "id": "prototype.skill.claude-dashboard",
        "title": "Open Claude Dashboard Editor",
        "when": "workspace"
      },
      {
        "id": "prototype.gallery",
        "title": "Open Design Gallery",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "gallery",
        "text": "Design",
        "icon": "layers",
        "tone": "accent",
        "tooltip": "Orca-Design · 打开设计项目库",
        "command": "prototype.gallery"
      }
    ],
    "keybindings": [
      {
        "command": "prototype.gallery",
        "key": "Mod+Alt+P",
        "when": "workspace"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "agent.status.changed"
      }
    ],
    "newFiles": [
      {
        "id": "new-prototype",
        "title": "HTML Prototype (.proto.html)",
        "extension": ".proto.html",
        "template": "templates/starter.proto.html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    }
  ]
}